# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/*.apk
downloads/*.zip
*.apk
# Mod APKs are tracked only in the top-level apks/ (single source of truth).
# Gradle copies them into a generated assets dir at build time; that copy stays ignored.
!apks/*.apk
!S1Mods*.apk
*.img
.env
.venv
env/
venv/
ENV/

# Repository reference / benchmark template
example for repo prepare/

# Android & ADB local keys
.android/
*.key
*.pub
/data/local/tmp/

# Release signing secrets (never commit)
keystore.properties
*.jks
*.keystore

# OS generated files
Thumbs.db
Desktop.ini
.DS_Store

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary and log files
*.log
*.tmp


# apksigner v4 signature side-files
*.idsig
