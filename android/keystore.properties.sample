# Copy to  android/keystore.properties  (git-ignored) and fill in to produce a
# properly release-signed S1Mods APK. Without it, release builds fall back to the
# debug key (fine for local testing, not for distribution). See docs/BUILD.md.
#
# Create a keystore once:
#   keytool -genkeypair -v -keystore s1mods-release.jks \
#     -alias s1mods -keyalg RSA -keysize 2048 -validity 10000
storeFile=s1mods-release.jks
storePassword=CHANGE_ME
keyAlias=s1mods
keyPassword=CHANGE_ME
